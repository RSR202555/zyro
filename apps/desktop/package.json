{
  "name": "@zyro/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && electron .",
    "package": "node build-config.js && tsc && electron-builder build --win"
  },
  "build": {
    "appId": "com.zyro.desktop",
    "productName": "Zyro",
    "electronVersion": "28.2.0",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "../../logozyro.png"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zyro"
    }
  },
  "devDependencies": {
    "electron": "28.2.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.3.3"
  }
}
